# Thong tin ket noi OpenAI-compatible lay tu 9Router
9ROUTER_API_KEY=
9ROUTER_BASE_URL=http://localhost:20128/v1
9ROUTER_TEXT_MODEL=gc/gemini-2.5-flash
9ROUTER_SCRIPT_MODEL=cx/gpt-5.1

# STT OpenAI Whisper
# Whisper chay local, lan dau se tu tai model ve may
LOCAL_WHISPER_MODEL=small

# Edge TTS khong can API key
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_ENGINE=auto

# Thu muc nhac duoc phep su dung (.mp3/.wav/.m4a/.aac)
MUSIC_DIR=./music
FONT_NAME=Montserrat
